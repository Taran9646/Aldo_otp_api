# Backend environment configuration.
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# These credentials must only ever live on the backend, never in the extension.

# --- Server ---
PORT=8080

# Optional: extra CORS origins (comma-separated). Shopify Checkout UI Extension
# origins are already allowed by default; add custom ones here if needed.
ALLOWED_ORIGINS=

# --- SMS provider (Synapse) ---
SYNAPSE_SMS_URL=http://api.me.synapselive.com/v1/multichannel/messages/sendsms
SYNAPSE_USERNAME=your_api_username
SYNAPSE_PASSWORD=your_api_password
SYNAPSE_SENDER_ID=your_sender_id

# --- OTP policy ---
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5

# --- Outbound request timeout (ms) ---
SMS_REQUEST_TIMEOUT_MS=10000
